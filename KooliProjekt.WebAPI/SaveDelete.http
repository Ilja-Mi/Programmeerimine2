@baseUrl = http://localhost:5086
# Run against a test database. These requests CREATE, UPDATE and DELETE data.
# The expected responses below have NOT been verified against a running API.
# First create test records. Then get their IDs from List and replace the zero placeholders.
# For Operation creation use the IDs of the newly created Car and OperationType.
# Delete the test Operation before the OperationType. Delete only your test records.
# Save: Id=0 creates; Id>0 updates. Success is 200 with an OperationResult.
# Swagger: http://localhost:5086/swagger -> endpoint -> Try it out -> Execute.
# The API does not implement login. Employee passwords are hashed on Save.
@carId = 0
@employeeId = 0
@administratorId = 0
@operationTypeId = 0
@operationId = 0

### Cars: CREATE (expected 200)
POST {{baseUrl}}/api/Cars/save
Content-Type: application/json

{
  "id": 0,
  "manufacturer": "Test",
  "model": "School car",
  "licensePlate": "TEST3010"
}

### Cars: LIST - find the ID of the created test record; change the variable above
GET {{baseUrl}}/api/Cars/list/1/100

### Cars: GET created record (expected 200 after setting the ID)
GET {{baseUrl}}/api/Cars/get/{{carId}}

### Cars: UPDATE (expected 200; blank employee password preserves the existing hash)
POST {{baseUrl}}/api/Cars/save
Content-Type: application/json

{
  "id": {{carId}},
  "manufacturer": "Test",
  "model": "Updated test model",
  "licensePlate": "TEST3010"
}

### Cars: GET again - verify the updated fields
GET {{baseUrl}}/api/Cars/get/{{carId}}

### Cars: invalid input (expected 400)
POST {{baseUrl}}/api/Cars/save
Content-Type: application/json

{
  "id": 0,
  "manufacturer": "",
  "model": "School car",
  "licensePlate": "TEST3010"
}

### Cars: negative Id (expected 400)
POST {{baseUrl}}/api/Cars/save
Content-Type: application/json

{
  "id": -1,
  "manufacturer": "Test",
  "model": "School car",
  "licensePlate": "TEST3010"
}

### Cars: update missing Id (expected 400; use valid related IDs for Operation)
POST {{baseUrl}}/api/Cars/save
Content-Type: application/json

{
  "id": 2147483647,
  "manufacturer": "Test",
  "model": "School car",
  "licensePlate": "TEST3010"
}

### Cars: invalid Delete Id (expected 400)
DELETE {{baseUrl}}/api/Cars/delete
Content-Type: application/json

{
  "id": 0
}

